{
  "buildCommand": "pnpm build",
  "outputDirectory": "build/client",
  "rewrites": [
    {
      "source": "/api/crm-oauth",
      "destination": "/api/events?action=crm-oauth"
    },
    {
      "source": "/api/swychr-poll",
      "destination": "/api/events?action=swychr-poll"
    },
    {
      "source": "/api/lifecycle-run",
      "destination": "/api/events?action=lifecycle-run"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/swychr-poll",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/lifecycle-run",
      "schedule": "0 * * * *"
    }
  ]
}
