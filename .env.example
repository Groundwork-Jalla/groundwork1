# Copy to .env and fill in. Never commit .env.
#
# VITE_* is compiled into the browser bundle and is public.
# Everything else is server-only and is read by the functions in api/.

# ── Client (public) ────────────────────────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SENTRY_DSN=
VITE_GA_MEASUREMENT_ID=

# ── Server (secret — api/ only, never VITE_) ───────────────
SUPABASE_URL=
# Bypasses RLS. The Stripe webhook is the only writer of subscription columns.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — Jalla Verify subscription only.
# Contractors are paid by Switchr in XAF, never through Stripe.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_JALLA_VERIFY=

# Optional; derived from the request when unset.
PUBLIC_SITE_URL=

# GoHighLevel inbound-webhook URLs (Automation -> Workflows -> Inbound Webhook).
# Leads are mirrored here; Supabase stays the source of truth. Server-only: a
# public URL would let anyone inject contacts into the CRM.
# Contractor applications. Unset is handled gracefully — the application still
# saves and the applicant is still emailed, the CRM forward is just skipped.
GHL_CONTRACTOR_WEBHOOK_URL=

# One inbound webhook for every other lifecycle event — signups, application decisions,
# subscription changes, projects created. They share it and carry an `event` field to
# branch on, so adding an event costs no new webhook. Unset = those events are skipped
# and the rows stay flagged as unsynced.
GHL_EVENT_WEBHOOK_URL=

# ── GoHighLevel API v2 (Phase 2) ─────────────────────────────────────────────
# With these set, events go through the API instead of the webhooks above: contacts are
# upserted by email so one person is one record, and we get back a contact id — which is
# what makes tags and pipeline moves possible at all. Unset = the webhooks keep working.
# Token: GHL > Settings > Private Integrations. Scope it to this location only.
GHL_API_TOKEN=
GHL_LOCATION_ID=

# Which pipeline, and which stage each event means. One JSON object so adding a stage is
# an env change, not a deploy. Keys may be suffixed ":variant" — e.g.
# {"user_signup":"stg_1","application_decision:accepted":"stg_4"}
# Unmapped events move nobody, which is the safe default.
GHL_PIPELINE_ID=
GHL_STAGE_MAP=

# Shared secret GHL must send as the X-Groundwork-Secret header on outbound webhooks
# pointed at /api/ghl/inbound. Unset = that endpoint refuses everything.
GHL_INBOUND_SECRET=

# Optional. Lets /api/ghl/retry be called by a scheduler instead of an admin.
CRON_SECRET=

RESEND_API_KEY=

# Where "new contractor application" alerts go. Falls back to contact@tryjalla.com
# if unset, which is easy to miss — set it explicitly per environment.
TEAM_INBOX=
